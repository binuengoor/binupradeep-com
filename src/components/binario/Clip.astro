---
// A short silent loop (AV1 with an H.264 fallback). The page script plays it only while it is on screen.
import { CLIPS } from './media';

interface Props { name: string; alt: string }
const { name, alt } = Astro.props;
const size = CLIPS[name];
if (!size) throw new Error(`Binario: no clip named "${name}"`);
const base = `/travel/eurotrip-2024/clips/${name}`;
---
<video class="b-clip" muted playsinline loop preload="none" poster={`${base}-poster.webp`} width={size[0]} height={size[1]} aria-label={alt}>
  <source src={`${base}.av1.mp4`} type='video/mp4; codecs="av01.0.08M.08"' />
  <source src={`${base}.h264.mp4`} type="video/mp4" />
</video>
