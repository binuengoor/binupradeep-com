---
// "More from the trip": the extra photos by day, with time and place, filterable by day.
import Pic from './Pic.astro';
import data from '../../travel/eurotrip-2024/gallery.json';

const days = data as { day: number; items: { src: string; time: string; place: string }[] }[];
---
<section class="b-gallery b-full" id="gallery" aria-labelledby="gallery-h">
  <div class="inner">
    <h2 id="gallery-h">More from the trip</h2>
    <p class="lede">The ones that didn't fit in the story, by day. Tap any photo to see it bigger.</p>
    <div class="tabs" role="toolbar" aria-label="Show photos from">
      <button type="button" data-day="all" aria-pressed="true">All days</button>
      {days.map((d) => <button type="button" data-day={String(d.day)} aria-pressed="false">Day {d.day}</button>)}
    </div>
    <div class="grid">
      {days.flatMap((d) => d.items.map((it) => (
        <figure class="b-zoom" data-day={String(d.day)}>
          <Pic name={it.src} alt={`Day ${d.day}, ${it.time}${it.place ? `, ${it.place}` : ''}`} sizes="(min-width: 1140px) 360px, (min-width: 700px) 46vw, 92vw" />
          <figcaption><span class="mono">Day {d.day} · {it.time}</span>{it.place}</figcaption>
        </figure>
      )))}
    </div>
  </div>
</section>
